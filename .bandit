# Bandit configuration for TDSM NLP Project
# See: https://bandit.readthedocs.io/en/latest/config.html

# Skip these tests globally as they are false positives for this ML project:
# B311 - random.* usage (used for data shuffling/sampling, NOT cryptographic purposes)
# B110 - try/except/pass (used intentionally for graceful error handling in ML pipelines)
skips:
  - B311
  - B110

# Exclude test directories and cached data
exclude_dirs:
  - tests
  - data_cache
  - htmlcov
  - __pycache__
  - .git
  - venv
  - venv311
